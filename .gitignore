# ============================================================
# Unreal Engine
# ============================================================

# Visual Studio / VS Code intermediate files
.vs/
.vscode/
*.opensdf
*.sdf
*.sln
*.suo
*.VC.db
*.VC.VC.opendb

# Rider
.idea/

# Compiled source files
*.pdb
*.obj

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/
Plugins/*/Binaries/

# Builds
Build/

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/PakBlacklist-*.txt

# Don't ignore Build.cs / Target.cs files in Source
!Source/**/*.Build.cs
!Source/**/*.Target.cs

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/
Config/DefaultEditorPerProjectUserSettings.ini

# Compiled source files for AssetRegistry
Intermediate/
Plugins/*/Intermediate/

# Cache files for the derived data cache
DerivedDataCache/

# Auto-generated VS project files
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# Auto-generated VS Code project files
.vscode

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Rider auto-generated files
*.tps

# Packaged builds
Saved/StagedBuilds/
Saved/Cooked/

# ============================================================
# Project-specific
# ============================================================

# Log files
*.log

# Crash reports
Saved/Crashes/